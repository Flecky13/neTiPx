<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:neTiPx.UI.Avalonia.Markup"
        xmlns:vm="using:neTiPx.UI.Avalonia.ViewModels"
        xmlns:services="using:neTiPx.UI.Avalonia.Services"
        x:Class="neTiPx.UI.Avalonia.Views.DesktopOverlaySettingsWindow"
        x:DataType="vm:SettingsViewModel"
        mc:Ignorable="d"
        d:DesignWidth="780"
        d:DesignHeight="820"
        Width="780"
        Height="820"
        MinWidth="640"
        MinHeight="520"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="{loc:Loc OVERLAY_SETTINGS_WINDOW_TITLE}">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource ComboBoxBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrush}" />
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel Spacing="12" Margin="16">
            <TextBlock Text="{loc:Loc OVERLAY_SETTINGS_TITLE}" FontWeight="Bold" FontSize="18" />
            <TextBlock Text="{loc:Loc OVERLAY_SETTINGS_DESC}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

            <CheckBox Content="{loc:Loc OVERLAY_INTERACTIVE_HOVER}"
                      IsChecked="{Binding DesktopOverlayHoverInteractive}" />

            <StackPanel Spacing="12"
                        IsEnabled="{Binding IsDesktopOverlaySettingsEditable}">
            <TextBlock Text="{loc:Loc OVERLAY_POSITION}" FontWeight="SemiBold" FontSize="12" />
            <ComboBox SelectedIndex="{Binding DesktopOverlayPositionIndex}">
                <ComboBoxItem Content="{loc:Loc OVERLAY_POS_TOP_LEFT}" />
                <ComboBoxItem Content="{loc:Loc OVERLAY_POS_TOP_RIGHT}" />
                <ComboBoxItem Content="{loc:Loc OVERLAY_POS_BOTTOM_LEFT}" />
                <ComboBoxItem Content="{loc:Loc OVERLAY_POS_BOTTOM_RIGHT}" />
                <ComboBoxItem Content="{loc:Loc OVERLAY_POS_FREE}" />
            </ComboBox>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_OFFSET_X}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayOffsetX}" Minimum="0" Maximum="5000" Increment="5" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_OFFSET_Y}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayOffsetY}" Minimum="0" Maximum="5000" Increment="5" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_WIDTH}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayWidth}" Minimum="180" Maximum="1200" Increment="10" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_HEIGHT}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayHeight}" Minimum="120" Maximum="2000" Increment="10" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:Loc OVERLAY_APPEARANCE}" FontWeight="SemiBold" FontSize="12" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_FONT_SIZE}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayFontSize}" Minimum="9" Maximum="36" Increment="1" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_FONT_FAMILY}" FontSize="12" />
                    <TextBox Text="{Binding DesktopOverlayFontFamily}" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_TEXT_COLOR}" FontSize="12" />
                    <TextBox Text="{Binding DesktopOverlayTextColor}" Watermark="#FFFFFFFF" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_BACKGROUND_COLOR}" FontSize="12" />
                    <TextBox Text="{Binding DesktopOverlayBackgroundColor}" Watermark="#1A1A1A" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_BACKGROUND_OPACITY}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayBackgroundOpacityPercent}" Minimum="0" Maximum="100" Increment="1" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_PADDING}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayPadding}" Minimum="0" Maximum="64" Increment="1" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_LINE_SPACING}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayLineSpacing}" Minimum="0" Maximum="32" Increment="1" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_CORNER_RADIUS}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayCornerRadius}" Minimum="0" Maximum="64" Increment="1" />
                </StackPanel>
            </Grid>

            <CheckBox Content="{loc:Loc OVERLAY_SHADOW}"
                      IsChecked="{Binding DesktopOverlayShadowEnabled}" />

            <TextBlock Text="{loc:Loc OVERLAY_REFRESH}" FontWeight="SemiBold" FontSize="12" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_REFRESH_NETWORK}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayNetworkRefreshSeconds}" Minimum="1" Maximum="3600" Increment="1" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_REFRESH_EXTERNAL_IP}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayExternalIpRefreshMinutes}" Minimum="1" Maximum="1440" Increment="1" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_REFRESH_RAM}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayRamRefreshSeconds}" Minimum="1" Maximum="3600" Increment="1" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{loc:Loc OVERLAY_REFRESH_UPTIME}" FontSize="12" />
                    <NumericUpDown Value="{Binding DesktopOverlayUptimeRefreshSeconds}" Minimum="1" Maximum="3600" Increment="1" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:Loc OVERLAY_FIELDS}" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Text="{loc:Loc OVERLAY_FIELDS_HINT}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

            <Button Command="{Binding AddDesktopOverlayItemCommand}"
                    HorizontalAlignment="Left"
                    Content="{loc:Loc OVERLAY_FIELDS_ADD}" />

            <ListBox ItemsSource="{Binding DesktopOverlayInfoItems}"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DesktopOverlayItemSettingViewModel">
                        <Border Padding="8"
                                Margin="0,0,0,6"
                                CornerRadius="6"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource CardBackgroundBrush}"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OverlayItemDragOver"
                                DragDrop.Drop="OverlayItemDrop">
                            <Grid ColumnDefinitions="Auto,*,*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="::" VerticalAlignment="Center" Opacity="0.6" PointerPressed="OverlayItemDragStart_OnPointerPressed" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding InfoOptions}"
                                          SelectedItem="{Binding SelectedInfoOption}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DesktopOverlayInfoOption">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{loc:Loc OVERLAY_SERVICE_SELECT}"
                                               FontSize="11"
                                               Opacity="0.7"
                                               IsVisible="{Binding IsServiceStatus}" />
                                    <AutoCompleteBox ItemsSource="{Binding Services}"
                                                     SelectedItem="{Binding SelectedService}"
                                                     IsDropDownOpen="{Binding IsServiceDropDownOpen, Mode=TwoWay}"
                                                     FilterMode="Contains"
                                                     MinimumPrefixLength="0"
                                                     GotFocus="ServiceSelector_OnGotFocus"
                                                     IsVisible="{Binding IsServiceStatus}">
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="services:SystemServiceInfo">
                                                <Border Background="{DynamicResource ComboBoxDropDownBackground}"
                                                        Padding="6,4">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource ListBoxItemForeground}" />
                                                </Border>
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                    <TextBox Text="{Binding CustomText}"
                                             MaxLength="32"
                                             Watermark="{loc:Loc OVERLAY_CUSTOM_TEXT}" />
                                </StackPanel>
                                <CheckBox Grid.Column="3"
                                          Content="{loc:Loc OVERLAY_SHOW_LABEL}"
                                          IsChecked="{Binding ShowLabel}"
                                          IsVisible="{Binding ShowLabelSelector}"
                                          VerticalAlignment="Center" />
                                <Button Grid.Column="4"
                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveDesktopOverlayItemCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{loc:Loc OVERLAY_FIELDS_REMOVE}"
                                        Padding="4"
                                        Background="Transparent">
                                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                              Width="14"
                                              Height="14" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
